{
  // O'Town Watersports: static site (./out) + a small Worker for the online waiver (worker/index.ts)
  "name": "otown-watersports",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // only the API runs code; every page and image is served straight from Cloudflare's cache
    "run_worker_first": ["/api/*"]
  },
  // signed waivers are emailed to the connected Google account; set WAIVER_TO to override
  "triggers": { "crons": ["0 7 1 * *"] },
  // signed waivers (auto-deleted after 3 years by the bucket's lifecycle rule)
  "r2_buckets": [{ "binding": "WAIVERS", "bucket_name": "otown-waivers" }]
  // Secrets (Cloudflare > Workers > otown-watersports > Settings > Variables and secrets):
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, ADMIN_KEY; then open /api/google/connect?key=ADMIN_KEY once
}
